generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
     directUrl = env("DIRECT_URL")
}

model Users {
    id_user      String                @id @default(uuid())
    name         String
    email        String                @unique(map: "users_email_unique")
    phone_number String?               @unique(map: "users_phone_unique")
    senha        String
    avatar       String?
    born         DateTime
    created_at   DateTime              @default(now())
    updated_at   DateTime              @updatedAt
    user_status  String                @default("ACTIVO")
    funcao_id    String
    avatarImages AvatarImagesArchive[] @relation("UserToAvatarImages")
    funcao       Funcao                @relation("UserToFuncao", fields: [funcao_id], references: [id_funcao], onDelete: Cascade)

    @@map("users")
}

model AvatarImagesArchive {
    id_avatar  String   @id @default(uuid())
    image      String
    user_id    String
    created_at DateTime @default(now())
    user       Users    @relation("UserToAvatarImages", fields: [user_id], references: [id_user], onDelete: Cascade)

    @@map("AvatarImagesHistoric")
}

model Funcao {
    id_funcao   String      @id @default(uuid())
    name_funcao String
    description String?
    created_at  DateTime    @default(now())
    updated_at  DateTime    @updatedAt
    status      String      @default("ACTIVO")
    users       Users[]     @relation("UserToFuncao")

    @@map("funcao")
}

model Products {
    id_product    String     @id @default(uuid())
    name_product  String
    description   String?
    logo          String?
    created_at    DateTime   @default(now())
    updated_at    DateTime   @updatedAt
    date_validate String
    price         String
    quantity      String
    methodPayment String     @default("CACHE")
    totalLucro    String?
    invoice       Invoices[]
    status        String     @default("NAO_VENDIDO")

    @@map("products")
}

model Stock {
    id_stock      String   @id @default(uuid())
    name          String
    description   String?
    created_at    DateTime @default(now())
    updated_at    DateTime @updatedAt
    date_validate String
    price         String
    quantity      String
    status        String   @default("NAO_VENDIDO")

    @@map("stock")
}

model Clients {
    id_client  String     @id @default(uuid())
    name       String
    telefone   String
    nif        String?
    created_at DateTime   @default(now())
    updated_at DateTime   @updatedAt
    invoices   Invoices[]

    @@map("clients")
}

model Invoices {
    id_invoice  String   @id @default(uuid())
    client_id   String
    product_id  String
    price       String
    date        DateTime
    created_at  DateTime @default(now())
    updated_at  DateTime @updatedAt
    approval    String   @default("NAO_PAGAS")
    clients     Clients  @relation(fields: [client_id], references: [id_client], onDelete: Cascade)
    products    Products @relation(fields: [product_id], references: [id_product], onDelete: Cascade)

    @@index([client_id])
    @@index([product_id])
    @@map("invoices")
}

model Venda {
    id            String   @id @default(uuid())
    name_product  String?
    description   String?
    methodPayment String   @default("CACHE")
    date_validate DateTime
    price         String
    quantity      String
    status        String   @default("VENDIDO")
    created_at    DateTime @default(now())
    updated_at    DateTime @updatedAt
    date_venda    DateTime @default(now())

    @@map("venda")
}